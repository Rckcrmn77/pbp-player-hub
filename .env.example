# Copy this file to `.env.local` for local development. Never commit real values.
# `.env.local` and every other `.env*` file (except this one) are ignored by git.

# --- Supabase ---
# Both values are public by design (access is enforced by Row Level Security).
# Local stack: run `npm run db:start`, then copy "API URL" and the publishable
# (or anon) key from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The Supabase secret (service role) key is intentionally not used by the app.
# Never add it with a NEXT_PUBLIC_ prefix.

# --- App ---
# Base URL used in links in emails, e.g. http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=

# --- Testing (optional) ---
# Path to a preinstalled Chromium for Playwright, if you don't run `npx playwright install`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Local test mailbox (Mailpit) used by e2e/parent-journey.spec.ts. Defaults to http://127.0.0.1:54324.
MAILPIT_URL=
