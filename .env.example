# Copy this file to `.env.local` for local development. Never commit real values.
# `.env.local` and every other `.env*` file (except this one) are ignored by git.

# --- Supabase (Sprint 0b / Sprint 1 — not used yet) ---
# Public values: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret: never prefix with NEXT_PUBLIC_ and never use in browser code.
SUPABASE_SECRET_KEY=

# --- App ---
# Public base URL of the deployment, e.g. http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=

# --- Testing (optional) ---
# Path to a preinstalled Chromium for Playwright, if you don't run `npx playwright install`.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
